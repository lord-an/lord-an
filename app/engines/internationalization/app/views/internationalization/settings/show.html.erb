<h1><%= t "internationalization.settings.title" %></h1>

<p><%= t "internationalization.settings.description" %></p>

<%= form_with url: locale_path, method: :patch do |form| %>
  <%= form.hidden_field :return_to, value: request.fullpath %>
  <%= form.label :locale, t("internationalization.settings.language") %>
  <%= form.select :locale, locale_options, selected: @preferred_locale %>
  <%= form.submit t("internationalization.settings.save") %>
<% end %>
