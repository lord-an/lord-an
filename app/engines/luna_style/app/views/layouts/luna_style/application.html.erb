<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || t("settings.page.title") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%= stylesheet_link_tag "luna_style/application", "tailwind", media: "all" %>
</head>
<body data-luna-style-theme="<%= luna_style_theme %>">
<%= render "shared/site_header", section: :settings %>
<%= render "shared/flash_messages" %>
<main class="page-container"><%= yield %></main>
</body>
</html>
