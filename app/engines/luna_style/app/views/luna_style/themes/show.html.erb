<header class="page-heading">
  <p class="eyebrow"><%= t "settings.page.appearance" %></p>
  <h1><%= t "settings.theme.title" %></h1>
  <p><%= t "settings.theme.description" %></p>
</header>

<section class="content-card">

<% if @theme_setting.errors.any? %>
  <div class="alert" role="alert">
    <ul>
      <% @theme_setting.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @theme_setting,
              scope: :theme_setting,
              url: theme_path,
              method: :patch do |form| %>
  <div>
    <%= form.label :theme, t("settings.theme.active") %>
    <%= form.select :theme,
                    LunaStyle::ThemeSetting::THEMES.map { |theme| [ theme.titleize, theme ] } %>
  </div>

  <%= form.submit t("settings.theme.save") %>
<% end %>
</section>
