<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || t("store.navigation.home") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%= stylesheet_link_tag "store/application", "luna_style/application", "tailwind", "actiontext", media: "all" %>
  <%= javascript_importmap_tags %>
</head>
<body data-luna-style-theme="<%= luna_style_theme %>" data-storefront-theme="<%= storefront_theme %>">
  <%= render "shared/site_header", section: :store %>
  <%= render "shared/flash_messages" %>
  <main class="page-container"><%= yield %></main>

</body>
</html>
