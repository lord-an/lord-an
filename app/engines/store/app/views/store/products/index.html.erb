<h1><%= t ".title" %></h1>

<%= link_to t("store.products.new"), new_product_path if authenticated? %>
<%= link_to t("authenticate.sign_up"), "/authenticate/registrations/new" unless authenticated? %>
<%= link_to t("authenticate.log_in"), "/authenticate/session/new" unless authenticated? %>

<div id="products">
  <% @products.each do |product| %>
    <div>
      <%= link_to product.localized_name, product_path(product) %>
    </div>
  <% end %>
</div>
