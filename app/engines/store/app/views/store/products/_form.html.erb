<%= form_with model: product do |form| %>
  <% if form.object.errors.any? %>
    <p class="error"><%= form.object.errors.full_messages.first %></p>
  <% end %>

  <div>
    <%= form.label :name, t("store.products.name"), style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, t("store.products.description"), style: "display: block" %>
    <%= form.rich_textarea :description %>
  </div>

  <fieldset>
    <legend><%= t "store.products.translations" %></legend>
    <%= form.fields_for :translations do |translation_form| %>
      <section>
        <h3><%= t "internationalization.languages.#{translation_form.object.locale}" %></h3>
        <%= translation_form.hidden_field :locale %>
        <div>
          <%= translation_form.label :name, t("store.products.name") %>
          <%= translation_form.text_field :name %>
        </div>
        <div>
          <%= translation_form.label :description, t("store.products.description") %>
          <%= translation_form.rich_textarea :description %>
        </div>
      </section>
    <% end %>
  </fieldset>

  <div>
    <%= form.label :featured_image, t("store.products.featured_image"), style: "display: block" %>
    <%= form.file_field :featured_image, accept: "image/png,image/jpeg,image/webp" %>
  </div>

  <div>
    <%= form.label :inventory_count, t("store.products.inventory_count"), style: "display: block" %>
    <%= form.number_field :inventory_count %>
  </div>

  <div>
    <%= form.label :shipping_weight_grams, t("store.products.shipping_weight_grams"), style: "display: block" %>
    <%= form.number_field :shipping_weight_grams, min: 1 %>
  </div>

  <div>
    <%= form.label :avatax_tax_code, t("store.products.avatax_tax_code"), style: "display: block" %>
    <%= form.text_field :avatax_tax_code, maxlength: 20 %>
  </div>

  <div>
    <%= form.label :price_cents, t("store.products.price"), style: "display: block" %>
    <%= form.number_field :price_cents, min: 1, step: 1, required: true %>
  </div>

  <div>
    <%= form.label :currency_code, t("store.products.currency"), style: "display: block" %>
    <%= form.text_field :currency_code, minlength: 3, maxlength: 3, pattern: "[A-Z]{3}", required: true %>
  </div>

  <div>
    <%= form.submit t("store.products.save") %>
  </div>
<% end %>
