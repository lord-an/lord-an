<p><%= link_to t("store.navigation.back"), products_path %></p>

<section class="product">
  <%= image_tag @product.featured_image if @product.featured_image.attached? %>

  <section class="product-info">
    <% cache [ @product, I18n.locale ] do %>
      <h1><%= @product.localized_name %></h1>
      <% if @product.price_set? %>
        <p><%= number_to_currency(@product.price_cents / 100.0, unit: @product.currency_code + " ") %></p>
      <% else %>
        <p><%= t "commerce.cart.price_unavailable" %></p>
      <% end %>
      <%= @product.localized_description %>
    <% end %>

    <%= render "inventory", product: @product %>
    <% if authenticated? && @product.inventory_count.positive? && @product.price_set? %>
      <%= form_with url: "/commerce/cart/items", scope: :cart_item do |form| %>
        <%= form.hidden_field :product_id, value: @product.id %>
        <%= form.number_field :quantity, value: 1, min: 1, max: @product.inventory_count, required: true %>
        <%= form.submit t("commerce.cart.add_item") %>
      <% end %>
    <% end %>
    <%= render "wishlist", product: @product %>

    <% if Current.user&.admin? %>
      <%= link_to t("store.products.edit"), edit_product_path(@product) %>
      <%= button_to t("store.products.delete"), @product, method: :delete, data: { turbo_confirm: t("store.products.confirm_delete") } %>
    <% end %>
  </section>
</section>

<%= render "reviews", product: @product, reviews: @reviews %>
