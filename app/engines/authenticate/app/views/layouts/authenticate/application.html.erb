<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Lord An" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "authenticate/application", "luna_style/application", media: "all" %>
</head>
<body data-luna-style-theme="<%= luna_style_theme %>">
  <%= render "shared/site_header", section: :account %>
  <%= render "shared/flash_messages" %>
  <main class="page-container"><%= yield %></main>
</body>
</html>
