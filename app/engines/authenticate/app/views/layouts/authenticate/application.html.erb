<!DOCTYPE html>
<html>
<head>
  <title>Authenticate</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "authenticate/application", "luna_style/application", media: "all" %>
</head>
<body data-luna-style-theme="<%= luna_style_theme %>">
  <nav>
    <%= link_to t("store.navigation.home"), "/store" %>
    <%= link_to t("internationalization.settings.title"), "/internationalization/settings" %>
  </nav>

  <div class="notice"><%= flash[:notice] %></div>
  <div class="alert"><%= flash[:alert] %></div>

  <main><%= yield %></main>
</body>
</html>
