<h1><%= t "authenticate.choose_new_password" %></h1>

<%= form_with url: "/authenticate/passwords/#{params[:token]}", method: :patch do |form| %>
  <div>
    <%= form.label :password, t("authenticate.password") %>
    <%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %>
    <small><%= t "authenticate.password_minimum_length" %></small>
  </div>

  <div>
    <%= form.label :password_confirmation, t("authenticate.password_confirmation") %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
  </div>

  <%= form.submit t("authenticate.update_password") %>
<% end %>
