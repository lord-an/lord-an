<!DOCTYPE html>
<html>
  <head>
    <title><%= t "commerce.cart.title" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "luna_style/application", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-luna-style-theme="<%= luna_style_theme %>">
    <nav>
      <%= link_to t("store.navigation.home"), "/store" %>
      <%= link_to t("commerce.cart.title"), cart_path %>
      <%= link_to t("commerce.orders.title"), orders_path %>
      <%= link_to t("portal.settings.title"), "/portal/settings" %>
    </nav>
    <p class="notice"><%= flash[:notice] %></p>
    <p class="alert"><%= flash[:alert] %></p>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
