<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("commerce.cart.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "luna_style/application", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-luna-style-theme="<%= luna_style_theme %>">
    <%= render "shared/site_header", section: :commerce %>
    <%= render "shared/flash_messages" %>
    <% if Current.user&.admin? %>
      <nav aria-label="<%= t('commerce.orders.title') %>"><%= link_to t("commerce.orders.title"), orders_path %></nav>
    <% end %>
    <main class="page-container"><%= yield %></main>
  </body>
</html>
