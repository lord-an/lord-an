<% if flash[:notice].present? || flash[:alert].present? %>
  <div class="flash-messages page-container" aria-live="polite">
    <% if flash[:notice].present? %>
      <p class="notice" role="status"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert].present? %>
      <p class="alert" role="alert"><%= flash[:alert] %></p>
    <% end %>
  </div>
<% end %>
