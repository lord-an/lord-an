<% content_for :title, t("home.title") %>

<main class="home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__content">
      <p class="home-eyebrow"><%= t("home.eyebrow") %></p>
      <h1 id="home-title"><%= t("home.hero_title") %></h1>
      <p class="home-hero__description"><%= t("home.description") %></p>
      <div class="home-actions">
        <%= link_to t("home.browse_products"), "/store", class: "home-button home-button--primary" %>
        <%= link_to t("home.create_account"), "/authenticate/registrations/new", class: "home-button home-button--secondary" %>
      </div>
    </div>
    <div class="home-hero__art" aria-hidden="true">
      <span class="home-hero__orbit home-hero__orbit--outer"></span>
      <span class="home-hero__orbit home-hero__orbit--inner"></span>
      <span class="home-hero__star">✳</span>
      <span class="home-hero__caption"><%= t("home.art_caption") %></span>
    </div>
  </section>

  <section class="home-highlights" aria-labelledby="home-highlights-title">
    <div class="home-section-heading">
      <p class="home-eyebrow"><%= t("home.highlights_eyebrow") %></p>
      <h2 id="home-highlights-title"><%= t("home.highlights_title") %></h2>
    </div>
    <div class="home-highlights__grid">
      <% %w[catalog reviews wishlists].each_with_index do |highlight, index| %>
        <article class="home-highlight">
          <span class="home-highlight__number"><%= format("%02d", index + 1) %></span>
          <h3><%= t("home.highlights.#{highlight}.title") %></h3>
          <p><%= t("home.highlights.#{highlight}.description") %></p>
        </article>
      <% end %>
    </div>
  </section>
</main>
